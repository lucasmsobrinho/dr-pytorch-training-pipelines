{
    "name": "02_VGG_Jabbar_ConstantLR_SGD_kaggle_256_faug",
    "n_gpu": 1,

    "arch": {
        "type": "VGG_Jabbar",
        "args": {
            "num_classes": 5,
            "freeze_cnn": false,
            "pretrained": true,
            "bn": false,
            "hidden_size": 512,
            "p_dropout": 0.2
        }
    },
    
    "preprocess": {
        "type": "none",
        "args": {
        }
    },
    "augmentation": {
        "type": "none",
        "args": {
        }
    },


    "train_set": {
        "type": "EyePacsDataset",
        "args": {
            "annotations_file": "train_aug_labels_stratified.csv",
            "img_dir": "data/aug_kaggle_prep_kaggle_256/train/"
        }
    },
    "valid_set": {
        "type": "EyePacsDataset",
        "args": {
            "annotations_file": "valid_aug_labels_stratified.csv",
            "img_dir": "data/aug_kaggle_prep_kaggle_256/train/"
        }
    },
    "test_set": {
        "type": "EyePacsDataset",
        "args": {
            "annotations_file": "test_labels.csv",
            "img_dir": "tkaggle256/"
        }
    },

    "data_loader": {
        "type": "EyePacsDataLoader",
        "args":{
            "batch_size": 64,
            "shuffle": true,
            "num_workers": 4
        }
    },

    "optimizer": {
        "type": "SGD",
        "args":{
            "lr": 0.001
        }
    },
    "loss": "cross_entropy_loss",
    "metrics": [
        "accuracy"
    ],
    "lr_scheduler": {
        "type": "ConstantLR",
        "args": {
            "total_iters": 1
        }
    },
    "trainer": {
        "epochs": 50,

        "save_dir": "saved/",
        "save_period": 25, 
        "verbosity": 2,

        "monitor": "min val_loss",
        "early_stop": 20,

        "tensorboard": true
    }
}
